config_version=5

[application]
config/name="המאפייה של נועה"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Game="*res://scripts/core/game.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=585
window/size/window_height_override=1266
window/vsync/vsync_mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]
pointing/emulate_touch_from_mouse=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
limits/opengl/max_lights_per_object=8
